.mfe-layout-grids-grid-cards {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: var(--mfe-layout-spacing-relaxed);
}

.mfe-layout-grids-grid-feature {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: var(--mfe-layout-spacing);
}

@media (min-width: 768px) and (max-width: 1023.98px) {
  .mfe-layout-grids-grid-feature {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (min-width: 576px) and (max-width: 767.98px) {
  .mfe-layout-grids-grid-feature {
    grid-template-columns: 1fr;
  }
}

.mfe-layout-stacks-stack-vertical {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: var(--mfe-layout-spacing-relaxed);
}

.mfe-layout-stacks-stack-horizontal {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: var(--mfe-layout-spacing-compact);
}

@media (min-width: 576px) and (max-width: 767.98px) {
  .mfe-layout-stacks-stack-horizontal {
    flex-direction: column;
  }
}

.mfe-layout-stacks-stack-pills {
  display: inline-flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: var(--mfe-layout-spacing-compact);
}

.mfe-layout-container-container-full {
  box-sizing: border-box;
  width: 100%;
  margin-left: auto;
  margin-right: auto;
  padding-left: var(--mfe-layout-container-full-inset);
  padding-right: var(--mfe-layout-container-full-inset);
  gap: var(--mfe-layout-container-full-gutter);
  display: flex;
  flex-direction: column;
}

.mfe-layout-container-container-wide {
  box-sizing: border-box;
  width: 100%;
  margin-left: auto;
  margin-right: auto;
  padding-left: var(--mfe-layout-container-wide-inset);
  padding-right: var(--mfe-layout-container-wide-inset);
  gap: var(--mfe-layout-container-wide-gutter);
  display: flex;
  flex-direction: column;
  max-width: 1600px;
}

.mfe-layout-container-container-narrow {
  box-sizing: border-box;
  width: 100%;
  margin-left: auto;
  margin-right: auto;
  padding-left: var(--mfe-layout-container-narrow-inset);
  padding-right: var(--mfe-layout-container-narrow-inset);
  gap: var(--mfe-layout-container-narrow-gutter);
  display: flex;
  flex-direction: column;
  max-width: none;
}

.mfe-layout-container-container {
  box-sizing: border-box;
  width: 100%;
  margin-left: auto;
  margin-right: auto;
  padding-left: var(--mfe-layout-container-inset);
  padding-right: var(--mfe-layout-container-inset);
  gap: var(--mfe-layout-container-gutter);
  display: flex;
  flex-direction: column;
  max-width: none;
}

