.dt-layout-grids-grid-cards {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: var(--dt-layout-spacing-relaxed);
}

.dt-layout-grids-grid-feature {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: var(--dt-layout-spacing);
}

@media (min-width: 768px) and (max-width: 1023.98px) {
  .dt-layout-grids-grid-feature {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (min-width: 576px) and (max-width: 767.98px) {
  .dt-layout-grids-grid-feature {
    grid-template-columns: 1fr;
  }
}

.dt-layout-stacks-stack-vertical {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: var(--dt-layout-spacing-relaxed);
}

.dt-layout-stacks-stack-horizontal {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: var(--dt-layout-spacing-compact);
}

@media (min-width: 576px) and (max-width: 767.98px) {
  .dt-layout-stacks-stack-horizontal {
    flex-direction: column;
  }
}

.dt-layout-stacks-stack-pills {
  display: inline-flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: var(--dt-layout-spacing-compact);
}

.dt-layout-container-container-full {
  box-sizing: border-box;
  width: 100%;
  margin-left: auto;
  margin-right: auto;
  padding-left: var(--dt-layout-container-full-inset);
  padding-right: var(--dt-layout-container-full-inset);
  gap: var(--dt-layout-container-full-gutter);
  display: flex;
  flex-direction: column;
}

.dt-layout-container-container-wide {
  box-sizing: border-box;
  width: 100%;
  margin-left: auto;
  margin-right: auto;
  padding-left: var(--dt-layout-container-wide-inset);
  padding-right: var(--dt-layout-container-wide-inset);
  gap: var(--dt-layout-container-wide-gutter);
  display: flex;
  flex-direction: column;
  max-width: 1600px;
}

.dt-layout-container-container-narrow {
  box-sizing: border-box;
  width: 100%;
  margin-left: auto;
  margin-right: auto;
  padding-left: var(--dt-layout-container-narrow-inset);
  padding-right: var(--dt-layout-container-narrow-inset);
  gap: var(--dt-layout-container-narrow-gutter);
  display: flex;
  flex-direction: column;
  max-width: none;
}

.dt-layout-container-container {
  box-sizing: border-box;
  width: 100%;
  margin-left: auto;
  margin-right: auto;
  padding-left: var(--dt-layout-container-inset);
  padding-right: var(--dt-layout-container-inset);
  gap: var(--dt-layout-container-gutter);
  display: flex;
  flex-direction: column;
  max-width: none;
}

@media (min-width: 576px) {
  .dt-layout-container-container {
    max-width: 576px;
  }
}

@media (min-width: 768px) {
