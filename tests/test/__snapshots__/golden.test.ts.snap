":root {
  --dt-layout-spacing: 16px;
  --dt-layout-spacing-none: 0px;
  --dt-layout-spacing-compact: 8px;
  --dt-layout-spacing-relaxed: 32px;
  --dt-layout-gutters: 16px;
  --dt-layout-gutters-compact: 8px;
  --dt-layout-gutters-relaxed: 32px;
  --dt-layout-gutters-loose: 48px;
  --dt-layout-gutters-none: 0px;
  --dt-layout-aspectratio: auto;
  --dt-layout-aspectratio-square: 1;
  --dt-layout-aspectratio-video: 16/9;
  --dt-layout-aspectratio-portrait: 3/4;
}

@media (min-width: 576px) and (max-width: 767.98px) {
  :root {
    --dt-layout-spacing-relaxed: 20px;
