":where(*,::before,::after) {
  box-sizing: border-box;
  border-width: 0;
  border-style: solid;
}

:where(body) {
  margin: 0;
  line-height: inherit;
}

:where(h1,h2,h3,h4,h5,h6) {
  font-size: inherit;
  font-weight: inherit;
  margin: 0;
}

:where(p,figure,blockquote,dl,dd) {
  margin: 0;
}

:where(ul,ol) {
  list-style: none;
  margin: 0;
  padding: 0;
}

:where(img,picture,video,canvas,svg) {
  display: block;
  max-width: 100%;
}

:where(button,input,select,textarea) {
  font: inherit;
  color: inherit;
}

:where(a) {
  color: inherit;
  text-decoration: inherit;
}

:where(h2) {
  font-size: var(--dt-typography-fontsize-3xl);
}

:where(h3) {
  font-size: var(--dt-typography-fontsize-2xl);
}

:where(h4) {
  font-size: var(--dt-typography-fontsize-xl);
}

:where(h5) {
  font-size: var(--dt-typography-fontsize-lg);
}

a {
  color: var(--dt-colors-primary);
  text-decoration: underline;
}

@media (min-width: 768px) {
  a {
    font-size: var(--dt-typography-fontsize-lg);
  }
}

a:hover {
  color: var(--dt-colors-primary-dark);
}

