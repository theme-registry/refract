exports[`emitTheme — CSS adapter \`split\` mode (9b) > writes styles.css + variables.css (defaults), no @import > split-styles.css 1`] = `
":where(*,::before,::after) {
  box-sizing: border-box;
  border-width: 0;
  border-style: solid;
}

:where(body) {
  margin: 0;
  line-height: inherit;
}

:where(h1,h2,h3,h4,h5,h6) {
  font-size: inherit;
  font-weight: inherit;
  margin: 0;
}

:where(p,figure,blockquote,dl,dd) {
  margin: 0;
}

:where(ul,ol) {
  list-style: none;
  margin: 0;
  padding: 0;
}

:where(img,picture,video,canvas,svg) {
  display: block;
  max-width: 100%;
}

:where(button,input,select,textarea) {
  font: inherit;
  color: inherit;
}

:where(a) {
  color: inherit;
  text-decoration: inherit;
}

:where(h2) {
  font-size: var(--dt-typography-fontsize-3xl);
}

:where(h3) {
  font-size: var(--dt-typography-fontsize-2xl);
}

:where(h4) {
  font-size: var(--dt-typography-fontsize-xl);
}

:where(h5) {
  font-size: var(--dt-typography-fontsize-lg);
}

a {
  color: var(--dt-colors-primary);
  text-decoration: underline;
}

@media (min-width: 768px) {
  a {
    font-size: var(--dt-typography-fontsize-lg);
  }
}

a:hover {
  color: var(--dt-colors-primary-dark);
}

a.subtle {
  color: var(--dt-colors-neutral);
}

a.subtle:hover {
  color: var(--dt-colors-primary);
}

.dt-colors-solid-primary {
  background: var(--dt-colors-primary);
  color: var(--dt-colors-primary-text);
}

.dt-colors-solid-danger {
  background: var(--dt-colors-danger);
  color: var(--dt-colors-danger-text);
}

.dt-colors-solid-success {
  background: var(--dt-colors-success);
  color: var(--dt-colors-success-text);
}

.dt-colors-solid-neutral {
  background: var(--dt-colors-neutral-light);
  color: var(--dt-colors-neutral-dark);
}

.dt-colors-outline-primary {
  border-color: var(--dt-colors-primary);
  color: var(--dt-colors-primary-dark);
}

.dt-typography-heading-h1 {
  font-family: var(--dt-typography-fontfamily-heading);
  font-size: var(--dt-typography-fontsize-3xl);
  font-weight: var(--dt-typography-fontweight-bold);
  line-height: var(--dt-typography-lineheight-tight);
  letter-spacing: var(--dt-typography-letterspacing-tight);
}

.dt-typography-heading-h2 {
  font-family: var(--dt-typography-fontfamily-heading);
  font-size: var(--dt-typography-fontsize-2xl);
  font-weight: var(--dt-typography-fontweight-bold);
  line-height: var(--dt-typography-lineheight-tight);
}

.dt-typography-heading-h3 {
  font-family: var(--dt-typography-fontfamily-heading);
  font-size: var(--dt-typography-fontsize-xl);
  font-weight: var(--dt-typography-fontweight-semibold);
}

.dt-typography-body-base {
  font-size: var(--dt-typography-fontsize);
  line-height: var(--dt-typography-lineheight);
}

.dt-typography-body-small {
  font-size: var(--dt-typography-fontsize-sm);
  line-height: var(--dt-typography-lineheight);
}

.dt-typography-body-large {
  font-size: var(--dt-typography-fontsize-lg);
  line-height: var(--dt-typography-lineheight-loose);
}

.dt-typography-button-large {
  font-size: var(--dt-typography-fontsize-lg);
  font-weight: var(--dt-typography-fontweight-medium);
}

.dt-typography-button-small {
  font-size: var(--dt-typography-fontsize-sm);
  font-weight: var(--dt-typography-fontweight-medium);
}

.dt-typography-code-inline {
  font-family: var(--dt-typography-fontfamily-mono);
  font-size: var(--dt-typography-fontsize-sm);
}

.dt-layout-container-container {
  box-sizing: border-box;
  width: 100%;
  margin-left: auto;
  margin-right: auto;
  padding-left: var(--dt-layout-container-inset);
  padding-right: var(--dt-layout-container-inset);
  max-width: 576px;
}

@media (min-width: 768px) {
  .dt-layout-container-container {
    max-width: 768px;
  }
}

@media (min-width: 1024px) {
  .dt-layout-container-container {
    max-width: 1024px;
  }
}

@media (min-width: 1280px) {
  .dt-layout-container-container {
    max-width: 1280px;
  }
}

.dt-layout-padding-card {
  padding-top: var(--dt-layout-spacing-xl);
  padding-bottom: var(--dt-layout-spacing-xl);
  padding-left: var(--dt-layout-spacing-xl);
  padding-right: var(--dt-layout-spacing-xl);
}

.dt-layout-padding-section {
  padding-top: var(--dt-layout-spacing-3xl);
  padding-bottom: var(--dt-layout-spacing-3xl);
  padding-left: var(--dt-layout-spacing-lg);
  padding-right: var(--dt-layout-spacing-lg);
}

.dt-layout-padding-button-lg {
  padding-top: var(--dt-layout-spacing-md);
  padding-bottom: var(--dt-layout-spacing-md);
  padding-left: var(--dt-layout-spacing-xl);
  padding-right: var(--dt-layout-spacing-xl);
}

.dt-layout-padding-button-sm {
  padding-top: var(--dt-layout-spacing-sm);
  padding-bottom: var(--dt-layout-spacing-sm);
  padding-left: var(--dt-layout-spacing-md);
  padding-right: var(--dt-layout-spacing-md);
}

.dt-effects-card-default {
  box-shadow: var(--dt-effects-shadow);
  transition: var(--dt-effects-transitions);
}

.dt-effects-card-elevated {
  box-shadow: var(--dt-effects-shadow-lg);
}

.dt-effects-card-flat {
  box-shadow: var(--dt-effects-shadow-none);
}

.dt-borders-box-default {
  border-radius: var(--dt-borders-radius);
}

.dt-borders-box-elevated {
  border-radius: var(--dt-borders-radius-lg);
}

.dt-borders-box-flat {
  border-radius: var(--dt-borders-radius-sm);
}

.dt-components-buttons-primary {
  cursor: pointer;
  border: none;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
}

.dt-components-buttons-primary-sm {
  cursor: pointer;
  border: none;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
}

.dt-components-buttons-danger {
  cursor: pointer;
  border: none;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.dt-components-cards-default {
  background: #fff;
  overflow: hidden;
}

.dt-components-cards-elevated {
  background: #fff;
  overflow: hidden;
}

.dt-components-badges-default {
  display: inline-flex;
  align-items: center;
  padding: 2px 8px;
  border-radius: 9999px;
}

.dt-components-badges-success {
  display: inline-flex;
  align-items: center;
  padding: 2px 8px;
  border-radius: 9999px;
}"
`;

