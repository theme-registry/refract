":root {
  --dt-colors-primary: rgb(77, 171, 247);
  --dt-colors-primary-text: rgb(255, 255, 255);
  --dt-colors-primary-lighter: rgb(230, 244, 255);
  --dt-colors-primary-darker: rgb(0, 96, 172);
  --dt-colors-primary-dark: rgb(28, 126, 214);
  --dt-colors-primary-light: rgb(165, 216, 255);
  --dt-colors-neutral: rgb(134, 142, 150);
  --dt-colors-neutral-text: rgb(255, 255, 255);
  --dt-colors-neutral-lighter: rgb(255, 255, 255);
  --dt-colors-neutral-darker: rgb(28, 33, 39);
  --dt-colors-neutral-light: rgb(241, 243, 245);
  --dt-colors-neutral-dark: rgb(52, 58, 64);
  --dt-colors-danger: rgb(255, 107, 107);
  --dt-colors-danger-text: rgb(255, 255, 255);
  --dt-colors-danger-light: rgb(255, 166, 161);
  --dt-colors-danger-lighter: rgb(255, 215, 212);
  --dt-colors-danger-dark: rgb(219, 74, 78);
  --dt-colors-danger-darker: rgb(184, 37, 49);
  --dt-colors-success: rgb(81, 207, 102);
  --dt-colors-success-text: rgb(255, 255, 255);
  --dt-colors-success-light: rgb(117, 240, 134);
  --dt-colors-success-lighter: rgb(212, 255, 215);
  --dt-colors-success-dark: rgb(39, 174, 70);
  --dt-colors-success-darker: rgb(0, 141, 47);
  --dt-colors-shadow: rgb(0, 0, 0);
  --dt-colors-shadow-light: rgb(3, 3, 3);
  --dt-colors-shadow-lighter: rgb(21, 21, 21);
  --dt-colors-shadow-dark: rgb(0, 0, 0);
  --dt-colors-shadow-darker: rgb(0, 0, 0);
  --dt-colors-shadow-a7: rgba(0, 0, 0, 0.07);
  --dt-colors-shadow-a10: rgba(0, 0, 0, 0.1);
  --dt-colors-shadow-a12: rgba(0, 0, 0, 0.12);
  --dt-typography-fontfamily: system-ui, -apple-system, sans-serif;
  --dt-typography-fontfamily-heading: Georgia, serif;
  --dt-typography-fontfamily-mono: 'Fira Code', monospace;
  --dt-typography-fontsize: 16px;
  --dt-typography-fontsize-xs: 12px;
  --dt-typography-fontsize-sm: 14px;
  --dt-typography-fontsize-lg: 20px;
  --dt-typography-fontsize-xl: 24px;
  --dt-typography-fontsize-2xl: 32px;
  --dt-typography-fontsize-3xl: 40px;
  --dt-typography-fontweight: 400;
  --dt-typography-fontweight-medium: 500;
  --dt-typography-fontweight-semibold: 600;
  --dt-typography-fontweight-bold: 700;
  --dt-typography-lineheight: 1.5;
  --dt-typography-lineheight-tight: 1.2;
  --dt-typography-lineheight-loose: 1.8;
  --dt-typography-letterspacing: 0em;
  --dt-typography-letterspacing-tight: -0.02em;
  --dt-typography-letterspacing-wide: 0.05em;
  --dt-layout-spacing: 8px;
  --dt-layout-spacing-xs: 4px;
  --dt-layout-spacing-sm: 6px;
  --dt-layout-spacing-md: 12px;
  --dt-layout-spacing-lg: 16px;
  --dt-layout-spacing-xl: 24px;
  --dt-layout-spacing-2xl: 32px;
  --dt-layout-spacing-3xl: 48px;
  --dt-layout-spacing-none: 0px;
  --dt-layout-container-inset: var(--dt-layout-spacing);
  --dt-effects-shadow: 0px 1px 3px var(--dt-colors-shadow-a10);
  --dt-effects-shadow-none: none;
  --dt-effects-shadow-md: 0px 4px 6px var(--dt-colors-shadow-a7);
  --dt-effects-shadow-lg: 0px 10px 20px var(--dt-colors-shadow-a10);
  --dt-effects-shadow-xl: 0px 20px 40px var(--dt-colors-shadow-a12);
  --dt-effects-transitions: all 150ms ease;
  --dt-effects-transitions-fast: all 80ms ease;
  --dt-effects-transitions-slow: all 300ms ease;
  --dt-borders-radius: 6px;
  --dt-borders-radius-none: 0px;
  --dt-borders-radius-sm: 4px;
  --dt-borders-radius-lg: 12px;
  --dt-borders-radius-xl: 16px;
  --dt-borders-radius-full: 9999px;
}"
`;

