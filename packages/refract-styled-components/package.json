{
  "name": "@theme-registry/refract-styled-components",
  "version": "0.1.6",
  "description": "The styled-components output adapter for @theme-registry/refract — emits TS/JS theme modules (literal theme object + tree-shakeable css recipes + GlobalStyle).",
  "author": {
    "name": "Petyo Stoyanov",
    "email": "petyosv@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theme-registry/refract.git",
    "directory": "packages/refract-styled-components"
  },
  "bugs": {
    "url": "https://github.com/theme-registry/refract/issues"
  },
  "homepage": "https://github.com/theme-registry/refract#readme",
  "license": "MIT",
  "main": "./dist/index.cjs.js",
  "module": "./dist/index.esm.js",
  "types": "./dist/index.d.ts",
  "files": [
    "/dist"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.cjs.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rollup -c",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "clean": "rimraf dist",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@theme-registry/refract": "workspace:^",
    "styled-components": "^6.0.0"
  },
  "peerDependenciesMeta": {
    "styled-components": {
      "optional": true
    }
  },
  "devDependencies": {
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^11.1.6",
    "@theme-registry/refract": "workspace:^",
    "@theme-registry/theme-fixtures": "workspace:^",
    "rimraf": "^5.0.5",
    "rollup": "^3.29.4",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "styled-components": "^6.4.0",
    "typescript": "^5.4.2",
    "vitest": "^4.1.10"
  }
}
