  },
  "dependencies": {
    "@theme-registry/refract": "workspace:^"
  },
  "devDependencies": {
    "@rollup/plugin-typescript": "^11.1.6",
    "@theme-registry/refract-css": "workspace:^",
    "rimraf": "^5.0.5",
    "rollup": "^3.29.4",
    "typescript": "^5.4.2",
    "vitest": "^4.1.10"
  }
